        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "& when not (@transp)": {
                "background": "linear-gradient(@angle * 1deg, @bg-value, @color2)"
              },
              "& when (@transp)": {
                "background": "transparent"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "50%",
              "height": "50%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "*": {
              "box-sizing": "border-box"
            },
            ".row": {
              "display": "flex !important",
              "flex-wrap": "wrap !important",
              "margin": "8px -16px",
              "justify-content": "center"
            },
            ".row:after": {
              "content": "\"\"",
              "display": "table",
              "clear": "both"
            },
            ".row, .row > .column": {
              "padding": "8px"
            },
            ".column": {
              "display": "none",
              "flex": "0 0 33.33% !important",
              "max-width": "33.33% !important",
              "padding": "8px !important",
              "float": "none !important"
            },
            ".show": {
              "display": "block",
              "flex-direction": "column !important"
            },
            ".content": {
              "background-color": "@ContentColor",
              "padding": "10px",
              "flex": "1 1 auto !important",
              "display": "flex !important",
              "flex-direction": "column !important",
              "height": "100%"
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".btn": {
              "border": "none",
              "outline": "none",
              "padding": "12px 16px",
              "background-color": "@ButtonColor",
              "cursor": "pointer"
            },
            ".btn:hover": {
              "background-color": "@ButtonColorOver"
            },
            ".btn.active": {
              "background-color": "@ButtonColorActive",
              "color": "white"
            },
            ".mbr-section-title": {
              "color": "#9fe870"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff"
            },
            "img": {
              "width": "100%"
            },
            "@media (max-width: 991px)": {
              ".column": {
                "float": "left !important",
                "width": "33.33% !important"
              }
            },
            "@media (max-width: 667px)": {
              ".column": {
                "flex": "0 0 33.33% !important",
                "max-width": "33.33% !important",
                "padding": "4px !important",
                "display": "flex !important",
                "flex-direction": "column !important"
              },
              ".content": {
                "background-color": "@ContentColor",
                "padding": "6px !important",
                "flex": "1 1 auto !important",
                "display": "flex !important",
                "flex-direction": "column !important",
                "height": "100%",
                "border-radius": "6px !important",
                "overflow": "hidden !important"
              },
              ".mbr-section-subtitle": {
                "font-size": "0.75rem !important",
                "line-height": "1.1 !important",
                "margin-top": "5px !important",
                "padding-bottom": "5px !important",
                "margin-bottom": "8px !important"
              },
              ".content p": {
                "font-size": "0.7rem !important",
                "line-height": "1.2 !important",
                "margin-bottom": "4px !important"
              },
              ".content p:last-of-type": {
                "margin-top": "auto !important",
                "padding-top": "8px !important",
                "margin-bottom": "5px !important",
                "font-weight": "normal"
              },
              ".column .mbr-section-btn": {
                "margin-top": "0 !important",
                "margin-bottom": "2px !important",
                "padding": "0 !important"
              },
              ".btn": {
                "padding": "4px 8px !important",
                "font-size": "0.7rem !important",
                "min-width": "auto !important"
              },
              ".column .btn": {
                "padding": "4px 8px !important",
                "font-size": "0.5rem !important",
                "border-radius": "4px !important",
                "display": "inline-block !important",
                "width": "auto !important"
              },
              ".content img": {
                "border-radius": "4px !important",
                "width": "100%",
                "margin-bottom": "5px !important",
                "transition": "all 0.4s ease-in-out",
                "cursor": "zoom-in",
                "z-index": "1",
                "position": "relative"
              },
              ".img-zoom-active": {
                "position": "fixed !important",
                "top": "50% !important",
                "left": "50% !important",
                "transform": "translate(-50%, -50%) scale(1) !important",
                "width": "80vw !important",
                "max-height": "80vh !important",
                "object-fit": "contain !important",
                "z-index": "9999 !important",
                "box-shadow": "0 0 50px rgba(0, 0, 0, 0.5)",
                "border-radius": "3px !important",
                "cursor": "zoom-out !important",
                "background-color": "rgba(0, 0, 0, 0.1)"
              },
              ".zoom-overlay": {
                "position": "fixed",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background": "rgba(0, 0, 0, 0.7)",
                "z-index": "9998",
                "display": "none"
              }
            }
          },
          "_name": "design-block",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content4\" group=\"Content\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" step=\"1\" value=\"9\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/lionaf.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#664306\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n\n        <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#232323\" condition=\"bg.type == 'color'\">\n         <input type=\"range\" name=\"angle\" title=\"Angle\" min=\"0\" max=\"270\" value=\"0\" step=\"1\" condition=\"bg.type == 'color'\">\n\t\t <input type=\"checkbox\" title=\"Background Transparent\" name=\"transp\" condition=\"bg.type == 'color'\">\n\t\t\n\t\t\n\t\t        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n\n            <header>Gallery</header>\n                  <input type=\"color\" title=\"Color\" name=\"ContentColor\" value=\"#757b62\">\n                 <input type=\"color\" title=\"Button Color\" name=\"ButtonColor\" value=\"#ffffff\">  \n          <input type=\"color\" title=\"Button Color Over\" name=\"ButtonColorOver\" value=\"#ffffff\"> \n                    <input type=\"color\" title=\"Button Color Active\" name=\"ButtonColorActive\" value=\"#666666\"> \n                            <input type=\"checkbox\" title=\"Button\" name=\"ButtonShop\" checked>  \n                                  \n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"title col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Produits</b></h3>\n                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Pour des raisons écologique et pour pouvoir vous proposer une personnalisation et rendre unique chaque objets, il n'y a pas de stock, tout est fabriqué sur demande.</h4>\n                <div class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-primary\" href=\"https://www.paypal.com/cgi-bin/webscr?cmd=_cart&amount=5.00&item_name=Candle%201&currency_code=USD\" data-app-placeholder=\"Type Text\">LEARN MORE</a>\n                    <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">LIVE DEMO</a></div>\n    <div id=\"myBtnContainer\">\n  <button class=\"btn active\" onclick=\"filterSelection('all')\"> Tout voir</button>\n  <button class=\"btn\" onclick=\"filterSelection('nature')\"> En ce moment</button>\n  <button class=\"btn\" onclick=\"filterSelection('cars')\"> Kit créatif</button>\n  <button class=\"btn\" onclick=\"filterSelection('people')\"> Décoration utile (ou pas)</button>\n  <button class=\"btn\" onclick=\"filterSelection('bois')\"> Médaille, Trophée</button>\n</div>\n\n<!-- Portfolio Gallery Grid -->\n<div class=\"row\">\n  <div class=\"column nature\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/affiche-panier-paques.webp\" alt=\"Mountains\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Kit Créatif du moment</h4>\n      <p>Passez un bon moment avec votre enfants, personnalisez avec vos propre couleurs et grace à un montage facile développez sa dextérité&nbsp;</p>\n       <p>Tarif:<b> 10 euros</b></p>\n        <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n         </div>\n  </div>\n  <div class=\"column nature\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/1773917864348.webp\" alt=\"Lights\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Œuf en bois</h4>\n      <p>Réalisé en bois (chêne), choisissez votre message à graver,<br>un cadeaux unique pour faire plaisir</p>\n        <p>Tarif: <b>15 euros</b></p>\n         <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n\n\n    </div>\n  </div>\n  <div class=\"column nature\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/cinma-leve-de-fonds-affiche-1.webp\" alt=\"Nature\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Création à la demande</h4>\n      <p>Vous ne trouvez pas ce que vous cherchez dans le catalogue ?<br>Faites moi part de vos envies les plus originales. Je donne vie à vos idées, de la conception à la réalisation finale, pour une pièce unique qui vous ressemble.</p>\n        <p>Tarif: <b>à la demande</b></p>\n              <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n  </div>\n\n  <div class=\"column cars\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/arbre-aux-gnogme-1131x1550.webp\" alt=\"Car\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Arbre aux Gnomes</h4>\n      <p><b>Kit créatif à monter et personnaliser sois même.</b><br>Jeu d'équilibre, où chacun à son tour dépose un gnome au dessus de l'arbre, attention à la chute</p>\n     <p>Tarif: <b>15 euros</b></p>\n                 <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n  </div>\n  <div class=\"column cars\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/kit-cra-janvier-794x1123.webp\" alt=\"Car\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">L'avion</h4>\n      <p><b>Kit créatif à monter et personnaliser sois même.</b><br>Votre enfants construit et personnalise son propre jouet</p>\n     <p>Tarif: <b>15 euros</b></p>\n        <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n  </div>\n  <div class=\"column cars\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/casse-tete-retro-896x1184.webp\" alt=\"Car\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Casse tête rétro</h4>\n      <p><b>Kit créatif à monter et personnaliser sois même.</b><br>Lance le dé, prend la pièce correspondante et essaye d'empiller un maximum de pièces</p>\n     <p>Tarif: <b>15 euros</b></p>\n    <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n      </div>\n  </div>\n\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/1759697984848-6-768x1344.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">lanceur de dés</h4>\n      <p>Lanceur de dés pour éviter qu'ils ne tombent n'impote où, repliable pour un rangement ou un transport facile</p>\n  <p>Tarif: <b>15 euros</b></p>\n    <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n  </div></div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-b3rzj7b3rzj7b3rz-2-896x1190.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Livre d'or</h4>\n      <p>Une façon originale de garder un souvenir d'un évènement, chaque invité peut écrire sur une feuille en bois et l'insérer dans le cadre.</p>\n     <p>Tarif: <b>70 euros</b></p>\n       <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n</div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/1759698331561.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Support bord de lit</h4>\n      <p>Support de smartphone avec passage pour le chargeur, repose lunettes et vide poches .</p>\n   <p>Tarif: <b>20 euros</b></p>\n            <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n  </div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/image1.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">coffre a jouer sur roue</h4>\n      <p>Votre enfant va adorer, il peut transporter avec lui ses jouets, monter dedans et parfait pour le faire ranger, il vous suit partout</p>\n  <p>Tarif: <b>80 euros</b></p>\n    <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n  </div></div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/1761049014457.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Cadre pour bracelet de naissance</h4>\n      <p>si vous voulez faire un cadeau original et personnalisé ou que vous avez gardé le bracelet de naissance dans une boîte, mettez le en valeur avec ce cadre.</p>\n     <p>Tarif: <b>10 euros</b></p>\n       <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n</div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-9la2p19la2p19la2-2-896x1190.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Bouquet de fleurs et vase en bois</h4>\n      <p>Les enfants décorent les fleurs à leurs convenance, pour faire un cadeaux unique</p>\n   <p>Tarif: à partir de <b>20 euros</b></p>\n            <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n  </div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-gc3v3lgc3v3lgc3v.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Décoration de parebrise&nbsp;</h4>\n      <p>Embellissez l'intérieur de votre véhicule avec ce pendentif en forme d'arbre de vie</p>\n  <p>Tarif: <b>10 euros</b></p>\n    <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n  </div></div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/1768517836732.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Cadre photo avec prénom</h4>\n      <p>Idéal pour affiché vos souvenirs partagés</p>\n     <p>Tarif: <b>40 euros</b></p>\n       <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n</div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/cinma-leve-de-fonds-affiche-3.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Création à la demande</h4>\n      <p>Vous ne trouvez pas ce que vous cherchez dans le catalogue ?\n<br>Faites moi part de vos envies les plus originales. Je donne vie à vos idées, de la conception à la réalisation finale, pour une pièce unique qui vous ressemble.</p>\n   <p>Tarif: <b>à la demande</b></p>\n            <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n  </div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-hq28b5hq28b5hq28.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Ambigramme</h4>\n      <p>Chaque angle un mot ou prénom différent</p>\n  <p>Tarif: <b>40 euros</b></p>\n    <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n  </div></div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-m115lom115lom115.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Décrocher la Lune</h4>\n      <p>Lampe lune avec son support en forme de main</p>\n     <p>Tarif: <b>50 euros</b></p>\n       <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n</div>\n  <div class=\"column people\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-2oi0022oi0022oi0.webp\" alt=\"People\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Création à la demande</h4>\n      <p>Besoin de réparer un appareil, car une pieces a casser je conçois, reproduit et imprime la piece.</p>\n   <p>Tarif: <b>à la demande</b></p>\n            <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n  </div>\n\n    <div class=\"column bois\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-e47c12e47c12e47c.webp\" alt=\"bois\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Médaille</h4>\n      <p>gravure personnalisée, dimension et forme au choix.</p>\n  <p>Tarif: à partir de<b> 3 euros</b></p>\n    <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n  </div></div>\n  <div class=\"column bois\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/gemini-generated-image-pdc9fapdc9fapdc9.webp\" alt=\"bois\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Trophée</h4>\n      <p>Sur une base à deux plaquette pour graver vos messages, le haut du modèle est entièrement personnalisable.</p>\n     <p>Tarif: à partir de <b>15 euros</b></p>\n       <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n</div>\n  <div class=\"column bois\">\n    <div class=\"content\">\n      <img src=\"@PROJECT_PATH@/assets/images/mapa-mental-brainstorming-lluvia-de-ideas-doodle-colorido-rosa-1.webp\" alt=\"bois\">\n       <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">Nouveau</h4>\n      <p>Même si de nouveaux modèles sont à venir, je peux à la demande concevoir des modèles unique.</p>\n   <p>Tarif: <b>sur demande</b></p>\n            <div class=\"mbr-section-btn align-center\" mbr-if=\"ButtonShop\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"page1.html#form02-1r\" data-app-placeholder=\"Type Text\">en savoir plus</a></div>\n    </div>\n  </div>\n\n<!-- END GRID -->\n</div>\n\n      [JS_CODE_0]   \n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "VOhLCbstl9",
          "_anchor": "design-block-VOhLCbstl9",
          "_sourceTheme": "startm5",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\n                filterSelection(\"all\") // Execute the function and show all columns\nfunction filterSelection(c) {\n  var x, i;\n  x = document.getElementsByClassName(\"column\");\n  if (c == \"all\") c = \"\";\n  // Add the \"show\" class (display:block) to the filtered elements, and remove the \"show\" class from the elements that are not selected\n  for (i = 0; i < x.length; i++) {\n    w3RemoveClass(x[i], \"show\");\n    if (x[i].className.indexOf(c) > -1) w3AddClass(x[i], \"show\");\n  }\n}\n\n// Show filtered elements\nfunction w3AddClass(element, name) {\n  var i, arr1, arr2;\n  arr1 = element.className.split(\" \");\n  arr2 = name.split(\" \");\n  for (i = 0; i < arr2.length; i++) {\n    if (arr1.indexOf(arr2[i]) == -1) {\n      element.className += \" \" + arr2[i];\n    }\n  }\n}\n\n// Hide elements that are not selected\nfunction w3RemoveClass(element, name) {\n  var i, arr1, arr2;\n  arr1 = element.className.split(\" \");\n  arr2 = name.split(\" \");\n  for (i = 0; i < arr2.length; i++) {\n    while (arr1.indexOf(arr2[i]) > -1) {\n      arr1.splice(arr1.indexOf(arr2[i]), 1);\n    }\n  }\n  element.className = arr1.join(\" \");\n}\n\n// Add active class to the current button (highlight it)\nvar btnContainer = document.getElementById(\"myBtnContainer\");\nvar btns = btnContainer.getElementsByClassName(\"btn\");\nfor (var i = 0; i < btns.length; i++) {\n  btns[i].addEventListener(\"click\", function(){\n    var current = document.getElementsByClassName(\"active\");\n    current[0].className = current[0].className.replace(\" active\", \"\");\n    this.className += \" active\";\n  });\n\n  // Sélectionne toutes les images dans les colonnes de la boutique\nconst images = document.querySelectorAll('.content img');\n\nimages.forEach(img => {\n    img.addEventListener('click', function() {\n        // Si l'image est déjà zoomée, on l'enlève\n        if (this.classList.contains('img-zoom-active')) {\n            this.classList.remove('img-zoom-active');\n        } else {\n            // On enlève le zoom sur toutes les autres images avant d'agrandir celle-ci\n            images.forEach(otherImg => otherImg.classList.remove('img-zoom-active'));\n            this.classList.add('img-zoom-active');\n        }\n    });\n});\n\n// Referme le zoom si on clique n'importe où ailleurs (optionnel)\ndocument.addEventListener('scroll', () => {\n    images.forEach(img => img.classList.remove('img-zoom-active'));\n});\n}</script>"
          ],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            ".mbr-overlay": {
