        {
          "alias": "zen2cool-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "& when not (@transp)": {
                "background": "linear-gradient(@angle * 1deg, @bg-value, @color2)"
              },
              "& when (@transp)": {
                "background": "transparent"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".slider-text-two": {
              "background": "fade(@textColor, @bgtxtzen * 1%) none repeat scroll 0 0",
              "backdrop-filter": "blur(@bluttxtzen * 1px)",
              "padding": "50px 50px",
              "outline": "(@outline * 1px) solid @outlinecolor",
              "outline-offset": "(@outlineoff * -1px)",
              "box-shadow": "(@LeRi * 1px) (@UpDo * 1px) (@Flou * 1px) (@FlouInt * 1px) @ShadowColor",
              "-moz-box-shadow": "(@LeRi * 1px) (@UpDo * 1px) (@Flou * 1px) (@FlouInt * 1px) @ShadowColor",
              "-webkit-box-shadow": "(@LeRi * 1px) (@UpDo * 1px) (@Flou * 1px) (@FlouInt * 1px) @ShadowColor"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "justify"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "letter-spacing": "(@letterspace * 1px)",
              "font-weight": "100",
              "text-align": "justify"
            },
            ".mbr-figure": {
              "margin": "0 auto",
              "width": "100%",
              "display": "-webkit-flex",
              "justify-content": "center",
              "-webkit-justify-content": "center",
              "img": {
                "height": "100%",
                "border-radius": "(@radius * 1px)",
                "-webkit-border-radius": "(@radius * 1px)",
                "-moz-border-radius": "(@radius * 1px)"
              }
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".slider-text-two": {
                "outline": "15px solid fade(@textColor, 80%)",
                "border": "1px solid fade(contrast(@textColor), 20%)"
              }
            },
            "@media (max-width: 767px)": {
              ".slider-text-two": {
                "padding": "2px 10px 10px 10px !important",
                "border-radius": "8px !important",
                "display": "inline-block !important",
                "width": "auto !important",
                "min-width": "200px",
                "margin": "0 auto !important",
                "float": "none !important"
              },
              ".mbr-section-title": {
                "font-size": "1.5rem !important",
                "margin": "0 !important",
                "padding": "0 !important",
                "line-height": "1"
              },
              ".mbr-figure": {
                "margin": "0 !important",
                "padding": "0 !important"
              },
              ".mbr-figure img": {
                "width": "70px !important",
                "height": "auto !important",
                "margin-bottom": "5px !important",
                "margin-top": "0 !important"
              },
              ".mbr-text": {
                "font-size": "0.9rem !important",
                "margin-bottom": "5px !important"
              },
              ".btn": {
                "padding": "5px 10px !important",
                "font-size": "0.8rem !important",
                "margin": "0 auto !important"
              }
            },
            ".snow1": {
              "background": "url(https://ya-webdesign.com/images250_/snow-background-png.png)",
              "background-repeat": "repeat",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "animation": "neve1 10s infinite linear"
            },
            ".snow2": {
              "background": "url(https://ya-webdesign.com/images250_/snow-background-png.png)",
              "background-repeat": "repeat",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "animation": "neve2 10s infinite linear",
              "background-size": "800px",
              "filter": "blur(1.5px)"
            },
            ".snow3": {
              "background": "url(https://ya-webdesign.com/images250_/snow-background-png.png)",
              "background-repeat": "repeat",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "animation": "neve3 10s infinite linear",
              "background-size": "1600px",
              "filter": "blur(1px)"
            },
            "@keyframes neve1": {
              "0%": {
                "background-position": "0px 0px"
              },
              "100%": {
                "background-position": "100px 650px"
              }
            },
            "@keyframes neve2": {
              "0%": {
                "background-position": "0px -100px"
              },
              "100%": {
                "background-position": "0px 650px"
              }
            },
            "@keyframes neve3": {
              "0%": {
                "background-position": "0px 100px"
              },
              "100%": {
                "background-position": "300px 650px"
              }
            },
            "H3": {
              "text-align": "justify"
            },
            "H1": {
              "text-align": "justify"
            }
          },
          "_name": "headerone",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"extHeader\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{\n         'mbr-fullscreen': fullScreen,\n         'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" title=\"Width Text\" name=\"widthText\" min=\"1\" max=\"7\" step=\"1\" value=\"7\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\">\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Bg Text Color\" name=\"textColor\" value=\"#232323\">\n        <input type=\"range\" name=\"bgtxtzen\" title=\"Fade\" min=\"0\" max=\"100\" value=\"0\" step=\"1\">\n                <input type=\"range\" name=\"bluttxtzen\" title=\"Blur\" min=\"0\" max=\"20\" value=\"3\" step=\"1\">\n        <input type=\"range\" name=\"letterspace\" title=\"Letter Spacing\" min=\"0\" max=\"5\" value=\"1\" step=\"1\">\n        <input type=\"range\" name=\"outline\" title=\"Outline\" min=\"0\" max=\"30\" value=\"1\" step=\"1\">\n                <input type=\"range\" name=\"outlineoff\" title=\"Outline Offset\" min=\"0\" max=\"30\" value=\"0\" step=\"1\">\n        <input type=\"color\" name=\"outlinecolor\" title=\"Color\" value=\"#ffffff\">\n                <select title=\"Align\" name=\"alignTitle\" condition=\"showTitle || showSubtitle\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\" selected>Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <header>Shadow</header>\n                 <input type=\"range\" inline title=\"Left/Right\" name=\"LeRi\" min=\"-20\" max=\"20\" step=\"1\" value=\"12\">\n         <input type=\"range\" inline title=\"Up/Down\" name=\"UpDo\" min=\"-20\" max=\"20\" step=\"1\" value=\"11\">\n         <input type=\"range\" inline title=\"Blur\" name=\"Flou\" min=\"-1\" max=\"25\" step=\"1\" value=\"25\">\n         <input type=\"range\" inline title=\"Blur Intensity\" name=\"FlouInt\" min=\"-16\" max=\"16\" step=\"1\" value=\"0\">\n         <input type=\"color\" title=\"Shadow Color\" name=\"ShadowColor\" value=\"#cebfaf\">\n        <input type=\"checkbox\" title=\"Snow effect\" name=\"snoweffect\">\n        <header>Images</header>\n        <input type=\"checkbox\" title=\"Image 1\" name=\"mediatop\" checked>\n        <input type=\"range\" inline title=\"Size\" name=\"mediaSizetop\" min=\"10\" max=\"100\" step=\"5\" value=\"10\" condition=\"mediatop\">\n         <input type=\"checkbox\" title=\"Image 2\" name=\"mediaup\">\n              <input type=\"range\" inline title=\"Size\" name=\"mediaSizeup\" min=\"10\" max=\"100\" step=\"5\" value=\"10\" condition=\"mediaup\">\n         <input type=\"checkbox\" title=\"Image 3\" name=\"mediadw\">\n        <input type=\"range\" inline title=\"Size\" name=\"mediaSizedw\" min=\"10\" max=\"100\" step=\"5\" value=\"10\" condition=\"mediadw\">\n        <input type=\"range\" inline title=\"Radius\" name=\"radius\" min=\"0\" max=\"1000\" step=\"1\" value=\"0\" condition=\"mediadw || mediaup || mediatop\">\n <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/lionaf.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#232323\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n        \n         <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#664306\" condition=\"bg.type == 'color'\">\n         <input type=\"range\" name=\"angle\" title=\"Angle\" min=\"0\" max=\"270\" value=\"0\" step=\"1\" condition=\"bg.type == 'color'\">\n\t\t <input type=\"checkbox\" title=\"Background Transparent\" name=\"transp\" condition=\"bg.type == 'color'\">\n\t\t\n\t\t\n\t\t        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\">\n    </div>\n  \n  \n  <div mbr-if=\"snoweffect\" class=\"snow1\"></div>\n  <div mbr-if=\"snoweffect\" class=\"snow2\"></div>\n  <div mbr-if=\"snoweffect\" class=\"snow3\"></div>\n  \n  \n    <div class=\"container text-center\" data-stellar-background-ratio=\".5\" mbr-syle=\"align-center\">\n          <div class=\"row slider-wrapper\" mbr-class=\"{'justify-content-center': alignTitle==2, 'justify-content-end': alignTitle==3}\">\n                <div mbr-class=\"{'col-lg-4 col-md-6': widthText == 1, 'col-lg-5 col-md-6': widthText == 2, 'col-md-6': widthText == 3, 'col-lg-8 col-md-6': widthText == 4, 'col-lg-9 col-md-12': widthText == 5, 'col-lg-10 col-md-12': widthText == 6, 'col-lg-12 col-md-12': widthText == 7}\">\n            <div class=\"slider-text  slider-text-two\">\n             <div class=\"mbr-figure pt-5\" mbr-if=\"mediatop\">\n                <img src=\"@PROJECT_PATH@/assets/images/logo-ju2.webp\" alt=\"Mobirise\" mbr-style=\"{'width': mediaSizetop + '%'}\">\n            </div>\n              <h2 mbr-if=\"showTitle\" class=\"mbr-section-title mbr-fonts-style mbr-bold align-center\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-section-title\">Mentions légales</h2>\n      <div class=\"mbr-figure pt-5\" mbr-if=\"mediaup\">\n                <img src=\"../_images/zen2cool.png\" alt=\"Mobirise\" mbr-style=\"{'width': mediaSizeup + '%'}\">\n      </div>\n                                    <h1 class=\"mbr-section-subtitle align-center mbr-light pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubTitle\"></h1>\n\t\t\t  <h4 class=\"mbr-text mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\"><div><b>Présentation du site</b></div><br><div><b>\n</b></div><div>Conformément aux dispositions des articles 6-III et 19 de la Loi n° 2004-575 du 21 Juin 2004 pour la Confiance dans l’économie numérique, nous portons à la connaissance des utilisateurs et visiteurs du site www.julabricole.fr les informations suivantes :\n</div><div>\n</div><b><div><b><br></b></div>Informations légales :\n</b><div><b><br></b></div><div>Le site www.julabricole.fr est géré par un auto-entrepreneur sous le régime de la Micro Entreprise ayant pour nom commercial julabricole.\n</div><div><b><br></b></div><div>Son siège social se situe au 23 route du Poirier rouge, 24700 Aint Martial d'Artenset, France.\n</div><div><b><br></b></div><div>La Micro Entreprise est déclarée sous le SIRET 791 698 574 00039.</div><br><div><b>1. Éditeur du site</b><br><br><div>Le site julabricole.fr<b>&nbsp;est édité par:</b></div><div><br></div><div>Nom / Raison Sociale : Julien PARZYCH</div><div><br></div><div>Siège social : 23 route du Poirier rouge 24700 Saint Martial d'Artenset</div><div><br></div><div>Contact : julabricole@free.fr / 07 71 67 88 30</div><div><br></div><div>Directeur de la publication : Julien PARZYCH</div><div><br></div><div><b>2. Hébergement</b></div><div><b><br></b></div><div>Le site est hébergé par la société GitHub Inc.</div><div><br></div><div>Siège social : 88 Colin P. Kelly Jr. St, San Francisco, CA 94107, USA.</div><div><br></div><div>Site web : https://pages.github.com</div><div><br></div><div>Contact : support@github.com</div><div><br></div><div><b>3. Propriété intellectuelle</b></div><div><b><br></b></div><div>L'ensemble des contenus (textes, images, logos) présents sur ce site est la propriété exclusive de Julien PARZYCH, sauf mention contraire. Toute reproduction est interdite sans accord préalable.</div><br><br><div><b>POLITIQUE DE CONFIDENTIALITÉ (RGPD)</b></div><br><div><b><br></b></div></div><br><div><div>L'hébergement du site est assuré par GitHub Pages. À ce titre, des données de connexion (logs serveurs) peuvent être collectées par l'hébergeur pour garantir la sécurité du service, conformément à sa propre politique de confidentialité.</div></div><br>Les messages envoyés via le formulaire de contact sont traités par le service Formoid pour assurer leur acheminement.<br><div><div><b><br></b></div><div><b>1. Gestion des Cookies</b></div><div><b><br></b></div><div>Conformément aux recommandations de la CNIL et au RGPD, ce site a été conçu pour respecter votre vie privée :</div><div><br></div><div>Aucun cookie traceur : Ce site n'utilise aucun cookie de mesure d'audience (statistiques), de publicité ou de réseaux sociaux.</div><div><br></div><div>Aucun dépôt de données : Votre navigation reste totalement anonyme et aucune donnée n'est stockée sur votre terminal par notre site.</div><div><br></div><div><b>2. Données personnelles (Formulaire de contact)</b></div><div><br></div><div>Les informations recueillies via le formulaire de contact (nom, adresse e-mail) sont utilisées exclusivement pour répondre à vos demandes de renseignements.</div><div><br></div><div>Durée de conservation : Ces données sont supprimées dès que l'échange est terminé ou après un délai maximum de [12 mois].</div><div><br></div><div>Vos droits : Vous pouvez exercer votre droit d'accès, de rectification ou de suppression de vos données en nous contactant à : julabricole@free.fr</div><div><br></div><div><b>3. Liens externes</b></div><div><b><br></b></div><div>Ce site peut contenir des liens vers d'autres sites. Nous ne sommes pas responsables de la politique de confidentialité ou du contenu de ces sites tiers.</div><br><div><br><br></div></div></h4><h4>\n            </h4> \n               <div class=\"mbr-figure pt-5\" mbr-if=\"mediadw\">\n                <img src=\"../_images/zen2cool.png\" alt=\"Mobirise\" mbr-style=\"{'width': mediaSizedw + '%'}\">\n            </div>\n           <div class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n           <span class=\"mbr-iconfont mbri-file\"></span>EN SAVOIR PLUS</a></div>\n                        \n            </div>\n\n        </div>\n      </div>\n    </div>\n    <div mbr-if=\"showArrow && fullScreen\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>",
          "_cid": "veotZ5K985",
          "_anchor": "headerone-2f",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden"
          },
          "_name": "footer04",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer4\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2e481a\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#2e481a\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center mbr-white\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright Ju la Bricole - Tout droits réservé.&nbsp; &nbsp;<a href=\"page2.html\" class=\"text-primary\">-Mentions légales-</a></p>\n            </div>\n        </div>\n    </div>\n</section>",
