        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff",
              "text-align": "left"
            },
            ".main-button": {
              "margin-bottom": "2rem",
              "@media (max-width: 767px)": {
                "margin-bottom": "2rem"
              }
            },
            ".mbr-text UL": {
              "text-align": "left"
            },
            ".mbr-section-subtitle, .main-button": {
              "color": "#ffffff"
            },
            ".accordion": {
              "max-width": "990px",
              "background": "rgba(0, 0, 0, 0.1)",
              "height": "300px",
              "margin": "20px auto",
              "display": "flex",
              "box-shadow": "0px 20px 30px rgba(0, 0, 0, 0.47)",
              "flex-direction": "row",
              "cursor": "pointer",
              "margin-bottom": "100px"
            },
            ".box": {
              "position": "relative",
              "height": "100%",
              "flex": "1",
              "background-position": "left",
              "background-size": "cover",
              "transition": ".7s",
              "box-shadow": "0px 20px 30px rgba(0, 0, 0, 0.47)"
            },
            ".box:hover": {
              "flex": "7",
              "height": "400px",
              "filter": "grayscale(0%)"
            },
            ".a1": {
              "background-image": "url(@imagevalue1)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            ".a2": {
              "background-image": "url(@imagevalue2)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            ".a3": {
              "background-image": "url(@imagevalue3)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            ".a4": {
              "background-image": "url(@imagevalue4)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            ".a5": {
              "background-image": "url(@imagevalue5)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            "p": {
              "font-weight": "normal",
              "font-family": "'Exo 2', sans-serif"
            },
            ".text": {
              "position": "absolute",
              "bottom": "0",
              "opacity": "0",
              "padding": "10px"
            },
            ".box:hover .text": {
              "opacity": "1",
              "background": "rgba(red(@colorbarre1), green(@colorbarre1), blue(@colorbarre1), @overlayOpacitybarre1)"
            },
            "@media screen and (max-width: 800px)": {
              "padding-top": "(@paddingTop * 0.1rem) !important",
              "padding-bottom": "(@paddingBottom * 0.1rem) !important",
              ".mbr-section-title, H2, [class*=\"display-\"]": {
                "font-size": "80% !important",
                "line-height": "1.1 !important",
                "margin-bottom": "1rem !important"
              },
              ".accordion": {
                "flex-direction": "row !important",
                "height": "250px !important",
                "width": "95% !important",
                "margin-bottom": "40px !important",
                "overflow": "hidden"
              },
              ".box": {
                "min-width": "40px"
              },
              ".box:hover": {
                "flex": "10 !important",
                "height": "250px !important"
              },
              ".text": {
                "padding": "5px !important"
              },
              ".text p": {
                "font-size": "10px !important",
                "line-height": "1 !important"
              },
              ".mobile-hint": {
                "display": "flex",
                "align-items": "center",
                "justify-content": "center",
                "gap": "8px",
                "margin-bottom": "15px",
                "color": "#9fe870",
                "font-family": "'Exo 2', sans-serif",
                "font-size": "0.9rem",
                "opacity": "0.8",
                "animation": "pulseHint 2s infinite"
              },
              ".mobile-hint .mbr-iconfont": {
                "font-size": "1.2rem"
              }
            },
            ".mbr-section-title": {
              "color": "#9fe870"
            },
            "H2": {
              "color": "#9fe870"
            },
            "P": {
              "color": "#ffffff"
            },
            ".mobile-hint": {
              "display": "none !important"
            },
            "@media (max-width: 767px)": {
              ".mobile-hint": {
                "display": "flex !important",
                "align-items": "center",
                "justify-content": "center",
                "width": "100%",
                "margin": "10px 0 20px 0",
                "color": "#9fe870 !important",
                "animation": "pulseHint 2s infinite",
                "z-index": "99"
              },
              ".hint-text": {
                "margin": "0 0 0 10px !important",
                "padding": "0 !important",
                "font-size": "1rem !important",
                "color": "#9fe870 !important",
                "font-family": "'Exo 2', sans-serif"
              },
              ".mobile-hint .mbr-iconfont": {
                "font-size": "1.5rem !important",
                "color": "#9fe870 !important"
              }
            },
            "@keyframes pulseHint": {
              "0%": {
                "opacity": "0.6",
                "transform": "scale(1)"
              },
              "50%": {
                "opacity": "1",
                "transform": "scale(1.05)"
              },
              "100%": {
                "opacity": "0.6",
                "transform": "scale(1)"
              }
            }
          },
          "_name": "design-block",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article021\" group=\"Article\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" name=\"showButton\" title=\"Buttons\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#232323\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        \n                 <input type=\"image\" title=\"Image 1\" name=\"imagevalue1\" value=\"@PROJECT_PATH@/assets/images/image1-800x919.webp\">\n              <input type=\"image\" title=\"Image 2\" name=\"imagevalue2\" value=\"@PROJECT_PATH@/assets/images/1772142850370-896x1184.webp\">\n                   <input type=\"image\" title=\"Image 3\" name=\"imagevalue3\" value=\"@PROJECT_PATH@/assets/images/gemini-generated-image-m115lom115lom115-2-768x1344.webp\">\n                        <input type=\"image\" title=\"Image 4\" name=\"imagevalue4\" value=\"@PROJECT_PATH@/assets/images/troff-632x990.webp\">\n                             <input type=\"image\" title=\"Image 5\" name=\"imagevalue5\" value=\"@PROJECT_PATH@/assets/images/1759698331561-1-1344x768.webp\">\n                                    <input type=\"color\" title=\"Background Color\" name=\"colorbarre1\" value=\"#000000\">\n                                     <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacitybarre1\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\">\n\n                                                                         <input type=\"checkbox\" title=\"Grayscale hover\" name=\"grayScale2\" checked>\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-lg-4\">\n                <div class=\"col-12 col-md-12\">\n                    <h5 class=\"mbr-section-title mbr-fonts-style mt-0 mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>Mes différents</b><br><b>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Services</b></h5>\n                    <h6 class=\"mbr-section-subtitle mbr-fonts-style mt-0 mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle, .main-button\" mbr-theme-style=\"display-7\">Mon engagement est simple : proposer des créations durables. J'utilise des matériaux respectueux de l'environnement et je pratique le recyclage pour certaines de mes matières premières.</h6>\n                    <div class=\"mbr-section-btn item-footer mt-3  main-button\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">Cliquez sur les images pour voir</a></div>\n                </div>\n            </div>\n\n            <div class=\"col-lg-8 side-features\">\n\n\n\n <div class=\"mobile-hint\">\n    <i class=\"mobi-mbri mobi-mbri-touch mbr-iconfont\"></i>\n    <p class=\"hint-text\">Cliquez sur les images pour voir</p>\n</div>\n\n\n <div class=\"accordion\">\n\n        <!-- BOX 1 -->\n        <div class=\"box a1\">\n            <div class=\"image_1\">\n                <div class=\"text\">\n                    <h2>Travail du bois</h2>\n                    <p>\n                        créations d'objets avec machine laser, fraiseuse numérique ou à la main selon modèle\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <!-- BOX 2 -->\n        <div class=\"box a2\">\n            <div class=\"image_2\">\n                <div class=\"text\">\n                    <h2>Kit Créatif</h2>\n                    <p>Chaque mois, un nouveau kit \n<br>à monter et personnaliser, adapté aux enfants.\n<br>Une activité ideal pour passer un bon moment avec son enfant</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- BOX 3 -->\n        <div class=\"box a3\">\n            <div class=\"image_3\">\n                <div class=\"text\">\n                    <h2>Impression 3D</h2>\n                    <p>\n                        Service d'impression 3D à la demande ou création de pièces sur mesure\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <!-- BOX 1 -->\n        <div class=\"box a4\">\n            <div class=\"image_4\">\n                <div class=\"text\">\n                    <h2>Médailles / Trophées</h2>\n                    <p>\n                        Conception sur mesure de récompense\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <!-- BOX 5 -->\n        <div class=\"box a5\">\n            <div class=\"image_5\">\n                <div class=\"text\">\n                    <h2>Objets utile et décoratif</h2>\n                    <p>Envie de faire un cadeaux ou décorer chez soi</p>\n                </div>\n            </div>\n        </div>\n\n    </div>\n            </div>\n        </div>\n    </div>\n    \n\n</section>",
          "_cid": "dzPbsP1PxN",
          "_anchor": "design-block-dzPbsP1PxN",
          "_sourceTheme": "startm5",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "zen2cool-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "& when not (@transp)": {
                "background": "linear-gradient(@angle * 1deg, @bg-value, @color2)"
              },
              "& when (@transp)": {
                "background": "transparent"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".slider-text-two": {
              "background": "fade(@textColor, @bgtxtzen * 1%) none repeat scroll 0 0",
              "backdrop-filter": "blur(@bluttxtzen * 1px)",
              "padding": "15px 50px 50px 50px",
              "border-radius": "12px",
              "border": "(@outline * 1px) solid @outlinecolor",
              "box-shadow": "(@LeRi * 1px) (@UpDo * 1px) (@Flou * 1px) (@FlouInt * 1px) @ShadowColor",
              "-moz-box-shadow": "(@LeRi * 1px) (@UpDo * 1px) (@Flou * 1px) (@FlouInt * 1px) @ShadowColor",
              "-webkit-box-shadow": "(@LeRi * 1px) (@UpDo * 1px) (@Flou * 1px) (@FlouInt * 1px) @ShadowColor"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "letter-spacing": "(@letterspace * 1px)",
              "font-weight": "100"
            },
            ".mbr-figure": {
              "margin": "0 auto",
              "width": "100%",
              "display": "-webkit-flex",
              "justify-content": "center",
              "-webkit-justify-content": "center",
              "img": {
                "height": "100%",
                "border-radius": "(@radius * 1px)",
                "-webkit-border-radius": "(@radius * 1px)",
                "-moz-border-radius": "(@radius * 1px)"
              }
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".slider-text-two": {
                "outline": "15px solid fade(@textColor, 80%)",
                "border": "1px solid fade(contrast(@textColor), 20%)"
              }
            },
            "@media (max-width: 767px)": {
              ".slider-text-two": {
                "padding": "2px 10px 10px 10px !important",
                "border-radius": "8px !important",
                "display": "inline-block !important",
                "width": "auto !important",
                "min-width": "200px",
                "margin": "0 auto !important",
                "float": "none !important"
              },
              ".mbr-section-title": {
                "font-size": "1.5rem !important",
                "margin": "0 !important",
                "padding": "0 !important",
                "line-height": "1"
              },
              ".mbr-figure": {
                "margin": "0 !important",
                "padding": "0 !important"
              },
              ".mbr-figure img": {
                "width": "70px !important",
                "height": "auto !important",
                "margin-bottom": "5px !important",
                "margin-top": "0 !important"
              },
              ".mbr-text": {
                "font-size": "0.9rem !important",
                "margin-bottom": "5px !important"
              },
              ".btn": {
                "padding": "5px 10px !important",
                "font-size": "0.8rem !important",
                "margin": "0 auto !important"
              }
            },
            ".snow1": {
              "background": "url(https://ya-webdesign.com/images250_/snow-background-png.png)",
              "background-repeat": "repeat",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "animation": "neve1 10s infinite linear"
            },
            ".snow2": {
              "background": "url(https://ya-webdesign.com/images250_/snow-background-png.png)",
              "background-repeat": "repeat",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "animation": "neve2 10s infinite linear",
              "background-size": "800px",
              "filter": "blur(1.5px)"
            },
            ".snow3": {
              "background": "url(https://ya-webdesign.com/images250_/snow-background-png.png)",
              "background-repeat": "repeat",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "animation": "neve3 10s infinite linear",
              "background-size": "1600px",
              "filter": "blur(1px)"
            },
            "@keyframes neve1": {
              "0%": {
                "background-position": "0px 0px"
              },
              "100%": {
                "background-position": "100px 650px"
              }
            },
            "@keyframes neve2": {
              "0%": {
                "background-position": "0px -100px"
              },
              "100%": {
                "background-position": "0px 650px"
              }
            },
            "@keyframes neve3": {
              "0%": {
                "background-position": "0px 100px"
              },
              "100%": {
                "background-position": "300px 650px"
              }
            }
          },
          "_name": "headerone",
          "_sourceTheme": "startm5",
          "_customHTML": "<section class=\"extHeader\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{\n         'mbr-fullscreen': fullScreen,\n         'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" title=\"Width Text\" name=\"widthText\" min=\"1\" max=\"7\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Bg Text Color\" name=\"textColor\" value=\"#232323\">\n        <input type=\"range\" name=\"bgtxtzen\" title=\"Fade\" min=\"0\" max=\"100\" value=\"0\" step=\"1\">\n                <input type=\"range\" name=\"bluttxtzen\" title=\"Blur\" min=\"0\" max=\"20\" value=\"0\" step=\"1\">\n        <input type=\"range\" name=\"letterspace\" title=\"Letter Spacing\" min=\"0\" max=\"5\" value=\"0\" step=\"1\">\n        <input type=\"range\" name=\"outline\" title=\"Outline\" min=\"0\" max=\"30\" value=\"1\" step=\"1\">\n                <input type=\"range\" name=\"outlineoff\" title=\"Outline Offset\" min=\"0\" max=\"30\" value=\"0\" step=\"1\">\n        <input type=\"color\" name=\"outlinecolor\" title=\"Color\" value=\"#ffffff\">\n                <select title=\"Align\" name=\"alignTitle\" condition=\"showTitle || showSubtitle\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\" selected>Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <header>Shadow</header>\n                 <input type=\"range\" inline title=\"Left/Right\" name=\"LeRi\" min=\"-20\" max=\"20\" step=\"1\" value=\"8\">\n         <input type=\"range\" inline title=\"Up/Down\" name=\"UpDo\" min=\"-20\" max=\"20\" step=\"1\" value=\"8\">\n         <input type=\"range\" inline title=\"Blur\" name=\"Flou\" min=\"-1\" max=\"25\" step=\"1\" value=\"25\">\n         <input type=\"range\" inline title=\"Blur Intensity\" name=\"FlouInt\" min=\"-16\" max=\"16\" step=\"1\" value=\"9\">\n         <input type=\"color\" title=\"Shadow Color\" name=\"ShadowColor\" value=\"#cebfaf\">\n        <input type=\"checkbox\" title=\"Snow effect\" name=\"snoweffect\">\n        <header>Images</header>\n        <input type=\"checkbox\" title=\"Image 1\" name=\"mediatop\" checked>\n        <input type=\"range\" inline title=\"Size\" name=\"mediaSizetop\" min=\"10\" max=\"100\" step=\"5\" value=\"10\" condition=\"mediatop\">\n         <input type=\"checkbox\" title=\"Image 2\" name=\"mediaup\">\n              <input type=\"range\" inline title=\"Size\" name=\"mediaSizeup\" min=\"10\" max=\"100\" step=\"5\" value=\"10\" condition=\"mediaup\">\n         <input type=\"checkbox\" title=\"Image 3\" name=\"mediadw\">\n        <input type=\"range\" inline title=\"Size\" name=\"mediaSizedw\" min=\"10\" max=\"100\" step=\"5\" value=\"10\" condition=\"mediadw\">\n        <input type=\"range\" inline title=\"Radius\" name=\"radius\" min=\"0\" max=\"1000\" step=\"1\" value=\"0\" condition=\"mediadw || mediaup || mediatop\">\n <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/lionaf.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#664306\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n        \n         <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#232323\" condition=\"bg.type == 'color'\">\n         <input type=\"range\" name=\"angle\" title=\"Angle\" min=\"0\" max=\"270\" value=\"0\" step=\"1\" condition=\"bg.type == 'color'\">\n\t\t <input type=\"checkbox\" title=\"Background Transparent\" name=\"transp\" condition=\"bg.type == 'color'\">\n\t\t\n\t\t\n\t\t        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\">\n    </div>\n  \n  \n  <div mbr-if=\"snoweffect\" class=\"snow1\"></div>\n  <div mbr-if=\"snoweffect\" class=\"snow2\"></div>\n  <div mbr-if=\"snoweffect\" class=\"snow3\"></div>\n  \n  \n    <div class=\"container text-center\" data-stellar-background-ratio=\".5\" mbr-syle=\"align-center\">\n          <div class=\"row slider-wrapper\" mbr-class=\"{'justify-content-center': alignTitle==2, 'justify-content-end': alignTitle==3}\">\n                <div mbr-class=\"{'col-lg-4 col-md-6': widthText == 1, 'col-lg-5 col-md-6': widthText == 2, 'col-md-6': widthText == 3, 'col-lg-8 col-md-6': widthText == 4, 'col-lg-9 col-md-12': widthText == 5, 'col-lg-10 col-md-12': widthText == 6, 'col-lg-12 col-md-12': widthText == 7}\">\n            <div class=\"slider-text  slider-text-two\">\n             <div class=\"mbr-figure pt-5\" mbr-if=\"mediatop\">\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-1.webp\" alt=\"Mobirise\" mbr-style=\"{'width': mediaSizetop + '%'}\">\n            </div>\n              \n           <div class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary\" href=\"page1.html\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-cursor-click mbr-iconfont mbr-iconfont-btn\"></span>\n           Boutique</a></div>\n                        \n            </div>\n\n        </div>\n      </div>\n    </div>\n    <div mbr-if=\"showArrow && fullScreen\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>",
          "_cid": "vekfQEJY2X",
          "_anchor": "headerone-2b",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "& when not (@transp)": {
                "background": "linear-gradient(@angle * 1deg, @bg-value, @color2)"
              },
              "& when (@transp)": {
                "background": "transparent"
              }
            },
            "H1": {
              "color": "#9fe870"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#ffffff"
            },
            "@keyframes zoomEtApparition": {
              "0%": {
                "opacity": "0",
                "transform": "scale(0.9)"
              },
              "15%, 85%": {
                "opacity": "1",
                "transform": "scale(1)"
              },
              "100%": {
                "opacity": "0",
                "transform": "scale(0.9)"
              }
            },
            ".img1": {
              "width": "90%",
              "box-shadow": "0 10px 55px 5px rgba(137, 173, 255, 0.35)",
              "border-radius": "10px"
            },
            ".relative": {
              "position": "relative"
            },
            ".img2": {
              "box-shadow": "0 10px 55px 5px rgba(137, 173, 255, 0.35)",
              "position": "absolute",
              "width": "60%",
              "top": "4rem",
              "right": "-5rem",
              "border-radius": "10px",
              "animation": "zoomEtApparition 7s ease-in-out infinite"
            },
            "@media (max-width: 576px)": {
              ".img1": {
                "width": "70% !important",
                "box-shadow": "0 10px 55px 5px rgba(137, 173, 255, 0.35) !important",
                "margin-left": "0"
              },
              ".img2": {
                "width": "60% !important",
                "top": "2rem !important",
                "right": "0rem !important",
                "box-shadow": "0 10px 55px 5px rgba(137, 173, 255, 0.35) !important"
              },
              ".mbr-text, .mbr-section-btn": {
                "font-size": "85%"
              },
              ".relative": {
                "overflow": "visible !important",
                "position": "relative",
                "width": "100%",
                "margin-right": "0"
              }
            }
